# Скопируйте этот файл в .env и вставьте свой ключ. Файл .env в git не попадает.
# Ключ Gemini (бесплатно): https://aistudio.google.com/ → Get API key
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Локальная модель вместо Gemini (нужен запущенный Ollama):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# 0 — не использовать кэш ответов модели (папка .cache)
LLM_CACHE=1

# Любой OpenAI-совместимый API (Groq, OpenRouter, OpenAI):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=openai/gpt-oss-120b
